# Local reference material (papers and third party clones), not redistributed
/papers/
/third_party/

# Generated outputs, at the project root only: a leading slash keeps code folders
# with the same name (peekaboo/data/, configs/data/) tracked
/data/
/datasets/
/runs/*
/outputs/
/checkpoints/
/figures/
/logs/

# Data files, wherever they are
*.npy
*.npz
*.parquet
*.feather
*.arrow
*.csv
*.h5
*.hdf5
*.pkl
*.pickle
*.mat
*-ubyte
*-ubyte.gz

# Model weights and checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Media produced by scripts
*.gif
*.mp4

# Experiment trackers
wandb/
mlruns/
lightning_logs/
tensorboard/
events.out.tfevents.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Editors and local settings
.vscode/
.idea/
.env

# Runs kept in git as reference results, with their checkpoint, logs, figures, and evaluation.
# Placed after the rules on data, weights, and media so that it overrides them, and before
# the macOS rules so that .DS_Store files stay ignored.
!/runs/pilot_prednet5l_w10/
!/runs/pilot_prednet5l_w10/**
!/runs/pilot_prednet5l_w10.log

# macOS
.DS_Store
._*
